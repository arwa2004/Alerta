# Copier en ".env" (alerta-backend/.env) puis adapter. Ne jamais committer ".env".
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True

# Base de données : "sqlite" (défaut) ou "postgres"
DB_ENGINE=sqlite
DB_NAME=alerta
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Planificateur : stockage privé des PDF et images rendues
# PRIVATE_MEDIA_ROOT=C:\alerta_private
PLANNER_MAX_UPLOAD_MB=20
PLANNER_MAX_PDF_PAGES=50
PLANNER_RENDER_DPI=150
PLANNER_MAX_RENDER_PIXELS=4000
